# ===== 运行环境 =====
APP_ENV=development
DEBUG=true

# 业务数据库。开发默认 SQLite；本地 Docker 环境使用：
# DATABASE_URL=postgresql+psycopg://agent_user:123456@127.0.0.1:5432/charge_identity_agent
DATABASE_URL=

# 本地 docker-compose 提供的 MySQL / PostgreSQL；未设置 DATABASE_URL 时优先 PostgreSQL
# MYSQL_URL=mysql+pymysql://agent_user:123456@127.0.0.1:3306/charge_identity
# POSTGRES_URL=postgresql+psycopg://agent_user:123456@127.0.0.1:5432/charge_identity_agent

# ===== 安全 =====
# 生产必须替换为 32 字节以上随机值：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-neighborhood-charging-secret-change-me
ACCESS_TOKEN_MINUTES=480
REFRESH_TOKEN_DAYS=7

# 设备网关接入密钥（可选）
DEVICE_API_KEY=

# ===== 演示数据 =====
DEMO_MODE=true
SEED_DEMO_DATA=true
# 演示环境数据库不可达时自动回退 SQLite；生产必须设为 false
ALLOW_SQLITE_FALLBACK=true

# ===== 跨域（多个用逗号分隔，* 仅用于开发）=====
CORS_ORIGINS=*

# ===== 可选 LLM（OpenAI 兼容接口）=====
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# ===== Agent =====
AGENT_TIMEOUT_MS=8000
